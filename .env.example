# ============================================================
# PrintGuard_Aholo 配置模板
# 用法：cp .env.example .env，然后填入你自己的值
#   - Docker：docker run --env-file .env ...
#   - 本地进程：set -a; source .env; set +a
# 全部项都有默认值；必须自己提供的只有 AHOLO_API_KEY（要用生成功能时）
# ============================================================

# ---------- 需要你自己提供 ----------

# Lux3D API Key（生成功能必需；体检/修复不需要）
# 免费申请：https://labs.aholo3d.cn/api-keys
AHOLO_API_KEY=

# ---------- HTTP 形态：地址与端口（按你的部署修改） ----------

# 监听地址：本机调试 127.0.0.1；服务器/Docker 部署 0.0.0.0
#PRINTGUARD_HOST=0.0.0.0

# 端口（默认 7860；云平台注入 PORT 环境变量时优先用 PORT）
#PRINTGUARD_PORT=7860

# MCP 端点路径（默认 /mcp，可改成任意路径）
#PRINTGUARD_HTTP_PATH=/mcp

# 公网前缀：有域名/反向代理时设置，交付结果 downloads 返回完整可点链接；
# 留空则返回相对路径 /d/<token>，由调用方按连接地址拼接
#PRINTGUARD_PUBLIC_BASE_URL=https://printguard.example.com

# ---------- 存储与交付（可选调整） ----------

# run 目录根：交付模型先落这里，托管形态成功后转入内存并删除（建议绝对路径）
#PRINTGUARD_RUNS_DIR=output/runs

# 模型下载链接有效期（分钟，默认 5，到期从内存清除）
#PRINTGUARD_DELIVERY_TTL_MIN=5

# 严格「下载一次即失效」（默认 0=按时效清除，浏览器预取不会提前吃掉链接）
#PRINTGUARD_DELIVERY_ONCE=0

# 限时交付内存总上限（MB，默认 256）
#PRINTGUARD_DELIVERY_MAX_MB=256

# 启动时清理超过 N 小时的残留 run 目录（默认 168=7 天，0 关闭）
#PRINTGUARD_RUN_RETENTION_HOURS=168

# ---------- 几何内核（可选调整） ----------

# 体素上限（内存护栏，超限自动放粗 pitch）：桌面默认 1.5e8；
# 约 2GB 内存的容器/服务器建议 2e7（实测 150mm 件峰值 872MB）
#PRINTGUARD_MAX_VOXELS=150000000

# ---------- 其他（可选调整） ----------

# 日志级别（日志只走 stderr，stdio MCP 下 stdout 是协议通道）
#PRINTGUARD_LOG_LEVEL=INFO

# 传输形态：stdio（默认，桌面 MCP 客户端直接拉起进程，无需 HTTP）；
# 服务器/Docker 部署改为 streamable-http
#PRINTGUARD_TRANSPORT=streamable-http

# 允许下载内网/保留地址（仅本地调试用，托管部署务必保持 0）
#PRINTGUARD_ALLOW_PRIVATE_URLS=0

# 打印 Lux3D 客户端请求细节（调试用）
#PRINTGUARD_VERBOSE=0
